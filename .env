# Local environment configuration
# IMPORTANT: This file is ignored by Git and should never be committed.
# Replace all placeholder values with your real secrets before running the app.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_your_livekit_api_key
LIVEKIT_API_SECRET=replace_with_your_livekit_api_secret

